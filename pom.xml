<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
        Parent: Spring Boot starter parent provides dependency management
        Think of it like inheriting default configurations from Spring Boot
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.2.0</version>
        <relativePath/>
    </parent>

    <!--
        Project Coordinates (Like your project's address)
        groupId: Organization (like com.google, com.amazon)
        artifactId: Project name
        version: Current version
    -->
    <groupId>com.example</groupId>
    <artifactId>studybuddy</artifactId>
    <version>0.1.0</version>
    <name>StudyBuddy</name>
    <description>Learning progress and reminder API for Docker/K8s practice</description>

    <!--
        Properties: Variables used throughout this file
    -->
    <properties>
        <java.version>17</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <!--
            Spring Boot Starter Web
            Purpose: Build REST APIs, handle HTTP requests
            Includes: Tomcat, Spring MVC, Jackson (JSON)
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!--
            Spring Boot Starter Validation
            Purpose: Validate user input (email format, required fields, etc.)
            Example: @NotNull, @Size(min=1, max=100), @Email
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>

        <!--
            Spring Boot Starter Data JPA
            Purpose: Database operations without writing SQL
            JPA = Java Persistence API (ORM - Object Relational Mapping)
            Think: Work with Java objects instead of SQL queries
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <!--
            PostgreSQL JDBC Driver
            Purpose: Connect to PostgreSQL database
            JDBC = Java Database Connectivity (like a phone carrier for database calls)
        -->
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
            Flyway Core
            Purpose: Database migration tool (version control for database schema)
            Manages SQL scripts in order: V1__init.sql, V2__add_column.sql, etc.
        -->
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>

        <!--
            Spring Boot Starter Actuator
            Purpose: Production-ready features (health checks, metrics)
            Endpoints: /actuator/health, /actuator/metrics
            Important for Kubernetes liveness/readiness probes!
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!--
            Spring Boot Starter Test
            Purpose: Testing framework
            Includes: JUnit 5, Mockito, AssertJ, Spring Test
            scope=test means only used during testing, not in production
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!--
                Spring Boot Maven Plugin
                Purpose: Package application as executable JAR
                Creates: target/studybuddy-0.1.0.jar
                This JAR contains everything: your code + all dependencies + embedded Tomcat
                Run with: java -jar studybuddy-0.1.0.jar
            -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
